# Data: raw public downloads, generated CSVs and local databases never go to git
data/raw/
data/*.db
data/backups/
data/exports/
*.zip
*.parquet

# Model artifacts and report images are rebuilt by `python tasks.py train`
src/model/artifacts/*
!src/model/artifacts/.gitkeep
# Kept: the synthetic model that was measured on the test period (3 KB). Every laptop and
# the server use this one, so the model card's test result and group audit stay valid.
# Public-data models stay out of git: they were trained on licensed files.
!src/model/artifacts/synthetic_bd/
reports/*.png
reports/**/*.png
# Kept: the ablation chart is part of the evidence (built from synthetic data only)
!reports/ablation/delivery_gain.png
# Kept: drawn from the saved test results; redrawing them never looks at the test period
!reports/*/calibration_test.png

# Secrets
.env

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# React dashboard
web/node_modules/
web/dist/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
