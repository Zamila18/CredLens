# CredLens server settings.
#
# On the server: copy this file to /opt/credlens/.env, edit it, then run
#     chmod 600 /opt/credlens/.env
# The systemd service reads it (EnvironmentFile), so write plain KEY=value lines: no quotes,
# no "export". NEVER commit the real .env. This template holds no real value.

# Production mode: the API serves no /docs, /redoc or /openapi.json pages.
CREDLENS_ENV=production

# The server runs the synthetic data only. Public data modes need raw files that must never
# be on a server (docs/SERVER_FILES.md).
CREDLENS_DATA_MODE=synthetic_bd

# Browser origins allowed to call the API directly. Nginx serves the dashboard and the API from
# one address, so none is needed: leave this empty. (Only if the dashboard is ever served from
# another address, put that address here, for example https://credlens.example.com)
CREDLENS_CORS_ORIGINS=

# Database. Empty: the local SQLite file data/app.db (what the demo uses).
DATABASE_URL=
