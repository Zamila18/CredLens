# Copy this file to .env and fill in real values. Never commit .env.

# Database connection string. Leave empty to use the local SQLite file (data/app.db).
# For the shared Supabase database, paste the Postgres connection string from the
# Supabase project settings, for example:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=

# Optional: override the data mode in config/default.yaml for one run.
# One of: synthetic_bd, kiva_asia, taiwan_cc, india_ltfs, homecredit
CREDLENS_DATA_MODE=

# --- Accounts (src/accounts/) ----------------------------------------------------------
# A long random secret (at least 32 characters) used to hash company invitation codes.
# Required on a production server. In development, when empty, a key is made once and kept in
# data/.secret_key (ignored by git).
CREDLENS_SECRET_KEY=

# The CredLens platform administrators: up to four staff accounts with platform-wide access,
# created ONLY by `python tasks.py admins` from these values. Passwords need at least 12
# characters with upper and lower case, a digit and a symbol. Running the command again never
# resets an existing password (use `python tasks.py admins --reset N` to do that on purpose).
# Leave a slot empty to leave it unused. Never put real values in this example file.
CREDLENS_PLATFORM_ADMIN_1_EMAIL=
CREDLENS_PLATFORM_ADMIN_1_PASSWORD=
CREDLENS_PLATFORM_ADMIN_2_EMAIL=
CREDLENS_PLATFORM_ADMIN_2_PASSWORD=
CREDLENS_PLATFORM_ADMIN_3_EMAIL=
CREDLENS_PLATFORM_ADMIN_3_PASSWORD=
CREDLENS_PLATFORM_ADMIN_4_EMAIL=
CREDLENS_PLATFORM_ADMIN_4_PASSWORD=

# Set to 1 only behind a reverse proxy that sets X-Forwarded-For itself (for rate limits).
CREDLENS_TRUST_PROXY=

# The benchmark (synthetic) database used only for model checks: python tasks.py data.
# Leave empty to use data/benchmark.db. The operational database is DATABASE_URL (above).
CREDLENS_BENCHMARK_DATABASE_URL=
